# ---------------------------------------------------------------------------
# Environment template
#
# Copy to `.env` and fill in locally.  Never commit `.env`.
# Keys follow the pattern GESTURE_AI__<SECTION>__<KEY> (double underscore).
# Values here are placeholders, not working defaults.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
GESTURE_AI__RUNTIME__MODE=demo                 # dev | demo | headless | replay
GESTURE_AI__RUNTIME__LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# --- Device selection --------------------------------------------------------
GESTURE_AI__CAMERA__INDEX=0
GESTURE_AI__CAMERA__WIDTH=640
GESTURE_AI__CAMERA__HEIGHT=480
GESTURE_AI__CAMERA__FPS=30
GESTURE_AI__AUDIO__DEVICE=                      # blank = OS default
GESTURE_AI__AUDIO__SAMPLE_RATE=16000

# --- Perception --------------------------------------------------------------
GESTURE_AI__PERCEPTION__MAX_HANDS=1
GESTURE_AI__PERCEPTION__DETECTION_CONFIDENCE=0.5
GESTURE_AI__PERCEPTION__TRACKING_CONFIDENCE=0.5

# --- Recognition -------------------------------------------------------------
GESTURE_AI__RECOGNITION__MODEL_ID=lstm
GESTURE_AI__RECOGNITION__MODEL_VERSION=0.0.0    # must match a registered version
GESTURE_AI__RECOGNITION__WINDOW_FRAMES=30
GESTURE_AI__RECOGNITION__STRIDE_FRAMES=3

# --- Activation --------------------------------------------------------------
GESTURE_AI__ACTIVATION__MODE=wake_gesture        # wake_gesture | hold_pose | push_to_talk
GESTURE_AI__ACTIVATION__HOLD_MS=800
GESTURE_AI__ACTIVATION__INACTIVITY_TIMEOUT_S=30

# --- Fusion (weights must sum to 1.0) ---------------------------------------
GESTURE_AI__FUSION__WEIGHT_GESTURE=0.55
GESTURE_AI__FUSION__WEIGHT_SPEECH=0.30
GESTURE_AI__FUSION__WEIGHT_CONTEXT=0.15
GESTURE_AI__FUSION__ASSOCIATION_WINDOW_MS=1500

# --- Safety ------------------------------------------------------------------
GESTURE_AI__SAFETY__MIN_FUSED_CONFIDENCE=0.75
GESTURE_AI__SAFETY__MIN_GESTURE_CONFIDENCE=0.70
GESTURE_AI__SAFETY__MIN_SPEECH_CONFIDENCE=0.65
GESTURE_AI__SAFETY__STABILITY_WINDOW=3
GESTURE_AI__SAFETY__COOLDOWN_MS=500
GESTURE_AI__SAFETY__MAX_ACTIONS_PER_MINUTE=12
GESTURE_AI__SAFETY__DRY_RUN=false

# --- Allowed adapters (comma separated) --------------------------------------
GESTURE_AI__SAFETY__ADAPTER_ALLOWLIST=powerpoint,media,ide

# --- Application context -----------------------------------------------------
GESTURE_AI__CONTEXT__POLL_INTERVAL_MS=200
GESTURE_AI__CONTEXT__STORE_WINDOW_TITLES=false

# --- Speech ------------------------------------------------------------------
GESTURE_AI__SPEECH__ENABLED=false
GESTURE_AI__SPEECH__ENGINE=faster-whisper
GESTURE_AI__SPEECH__MODEL_SIZE=small             # tiny | base | small | medium
GESTURE_AI__SPEECH__MAX_UTTERANCE_S=5

# --- API ---------------------------------------------------------------------
GESTURE_AI__API__HOST=127.0.0.1
GESTURE_AI__API__PORT=8000
GESTURE_AI__API__BIND_PUBLIC=false               # requires a token if true
# GESTURE_AI__API__TOKEN=                        # generate locally; never commit

# --- Database ----------------------------------------------------------------
# SQLite is the default.  A PostgreSQL URL is supported by the same schema.
GESTURE_AI__DATABASE__URL=sqlite:///./gesture.db
# GESTURE_AI__DATABASE__URL=postgresql+psycopg://user:pass@localhost:5432/gesture

# --- Paths (must sit inside allowlisted roots) -------------------------------
GESTURE_AI__PATHS__MODELS_DIR=./models
GESTURE_AI__PATHS__DATASETS_DIR=./datasets
GESTURE_AI__PATHS__LOG_DIR=./logs

# --- Frontend ----------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_WS_URL=ws://127.0.0.1:8000/api/v1/ws/events
