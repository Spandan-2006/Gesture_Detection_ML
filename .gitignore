# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------------------------------------------------------------------------
# Research data (S5)
#   Raw and processed samples are never committed: size and privacy.
#   Release manifests and split manifests ARE tracked — they are the
#   reproducibility record and contain no personal data.
# ---------------------------------------------------------------------------
datasets/raw/
datasets/processed/
datasets/**/*.npz
datasets/**/*.npy
datasets/**/*.wav
datasets/**/*.mp4
datasets/**/*.avi
!datasets/annotations/**
!datasets/**/README.md

# ---------------------------------------------------------------------------
# Model artefacts (S4)
#   Weights are large and reproducible from a recorded run.
#   Model cards and configuration ARE tracked.
# ---------------------------------------------------------------------------
models/checkpoints/
models/**/*.pt
models/**/*.pth
models/**/*.pkl
models/**/*.joblib
models/**/*.onnx
models/**/*.bin
models/**/*.safetensors
!models/**/model_card.json
!models/configs/**

# ---------------------------------------------------------------------------
# Experiment output
#   Configurations are tracked; generated results are not.
# ---------------------------------------------------------------------------
experiments/results/*
!experiments/results/.gitkeep
experiments/**/runs/
*.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Runtime output
# ---------------------------------------------------------------------------
logs/
*.log
*.jsonl
!docs/**/*.jsonl

# Local database
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Operating system
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Editors
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---------------------------------------------------------------------------
# Temporary and scratch
# ---------------------------------------------------------------------------
*.tmp
*.bak
*.orig
scratch/
tmp/
